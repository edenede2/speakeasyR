install.packages(c("IRkernel","callr","ps","readr","ggplot2","lobstr"))
monitor_ram_start <- function(path = "ram_log.csv", interval = 0.5) {
if (!requireNamespace("callr", quietly = TRUE)) stop("Need {callr}")
  if (!requireNamespace("ps", quietly = TRUE))     stop("Need {ps}")
  pid <- Sys.getpid()

  proc <- callr::r_bg(
    func = function(pid, path, interval) {
      if (!requireNamespace("ps", quietly = TRUE)) stop("Need {ps}")
      h <- ps::ps_handle(pid)
      con <- file(path, open = "wt")
      on.exit(try(close(con), silent = TRUE), add = TRUE)
      writeLines("timestamp_sec,rss_mb,vms_mb", con)

      repeat {
        if (!ps::ps_is_running(h)) break
        mi <- ps::ps_memory_info(h) # rss & vms בבתים
        ts <- as.numeric(Sys.time())
        line <- sprintf("%.3f,%.3f,%.3f",
                        ts, mi$rss / (1024^2), mi$vms / (1024^2))
        writeLines(line, con)
        flush(con)
        Sys.sleep(interval)
      }
    },
    args = list(pid, path, interval)
  )
  proc
}

monitor_ram_stop <- function(proc) {
  if (!inherits(proc, "r_process")) return(invisible(FALSE))
  if (proc$is_alive()) proc$kill()
  invisible(TRUE)
}

log_ram_while <- function(expr, path = "ram_log.csv", interval = 0.5) {
  proc <- monitor_ram_start(path = path, interval = interval)
  on.exit(monitor_ram_stop(proc), add = TRUE)
  force(expr)
  invisible(path)
}
